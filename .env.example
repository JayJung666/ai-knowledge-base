# ─── LLM ─────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ─── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Daftar origin yang diizinkan, pisahkan dengan koma
# Contoh production: https://your-app.vercel.app,https://yourdomain.com
CORS_ORIGINS=*

# ─── Resource Limits (Optimal untuk Render Free 512MB RAM) ───────────────────
MAX_FILE_SIZE_MB=5
MAX_DOCS_PER_THREAD=10
